#!/usr/bin/env python3
"""Launch the packaged CLI with its locked uv environment."""

import subprocess
import sys
from pathlib import Path


def main() -> int:
    """Run the packaged command.

    Returns
    -------
    int
        Command exit status.
    """
    root = Path(__file__).resolve().parents[1]
    try:
        return subprocess.call(
            [
                "uv",
                "run",
                "--locked",
                "--project",
                str(root),
                "python-style",
                *sys.argv[1:],
            ]
        )
    except FileNotFoundError:
        print("python-style requires uv on PATH.", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
