#!/usr/bin/env python3
"""Launch the packaged CLI with its locked uv environment."""

import logging
import subprocess
import sys
from pathlib import Path


def main() -> int:
    """Run the packaged command.

    Returns
    -------
    int
        Command exit status.
    """
    logging.basicConfig(level=logging.INFO, format="%(levelname)s: %(message)s")
    root = Path(__file__).resolve().parents[1]
    try:
        return subprocess.call(
            [
                "uv",
                "run",
                "--locked",
                "--project",
                str(root),
                "python-style",
                *sys.argv[1:],
            ]
        )
    except FileNotFoundError:
        # python-style: allow[caught-error] Report the missing executable and return a CLI failure status.
        logging.error(
            "Cannot launch python-style: executable uv was not found on PATH."
        )
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
